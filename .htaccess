<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # If the request is for the root, rewrite to dist/index.html
    RewriteRule ^$ dist/index.html [L]

    # If the request is not for a file/directory appearing to be in root (but actually in dist), 
    # check if it exists in dist and rewrite
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
    RewriteRule ^(.*)$ dist/$1 [L]

    # Handle SPA routing: if file doesn't exist in root OR dist, route to dist/index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . dist/index.html [L]
</IfModule>
